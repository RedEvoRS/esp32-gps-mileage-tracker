# Server files get copied from a Windows checkout to Linux; scripts and
# unit files with CRLF line endings fail there.
*.sh text eol=lf
# The generator's --check compares exact bytes on Windows and Linux.
firmware/04_trip_logger/diag_catalog.h text eol=lf
*.service text eol=lf
*.timer text eol=lf
server/backup/backup.conf.example text eol=lf
# Env templates become .env files that Compose and the firmware read
# byte for byte; a CRLF would end every value with a stray \r.
server/.env.example text eol=lf
server/viewer.env.example text eol=lf
# Commit archives carry provenance even when the server has no Git metadata.
server/COMMIT text eol=lf export-subst
