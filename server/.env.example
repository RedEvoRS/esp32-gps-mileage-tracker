# Mileage Tracker Ingest Service - Environment Configuration
#
# Copy this file to .env (without the .example suffix) and fill in
# real values. The .env file should NEVER be committed to version
# control because it contains secrets.
#
# To generate a strong random token on Linux, run:
#   openssl rand -hex 32
#
# That produces a 64-character hexadecimal string. Use the output as
# the value of INGEST_AUTH_TOKEN below. You'll use this same token
# in the T-Beam firmware so it can authenticate its uploads.
#
# The firmware has the token compiled in. If you change it here later,
# put the new value in the firmware's secrets.h and flash the board
# again, or every upload is refused (401).
#
# After editing this file, run "docker compose up -d" so the containers
# pick up the change; "docker compose restart" keeps the old values.

INGEST_AUTH_TOKEN=replace-me-with-openssl-rand-hex-32-output

# The host address both services publish their ports on. Set it to this
# server's LAN IP once it has a static IP or DHCP reservation, e.g.
#   BIND_ADDR=192.168.1.10
# Left unset, the ports listen on every interface. A UFW rule won't
# narrow that: Docker routes published ports around UFW. See
# DEPLOY_DEBIAN.md Step 7.
BIND_ADDR=
