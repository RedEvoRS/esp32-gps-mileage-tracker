# Optional: copy to monitor.env, chmod 600, and set MONITOR_ENV_FILE=./monitor.env
# in .env. Then explicitly start the monitor profile (DEPLOY_DEBIAN.md Step 11).
# install.sh's Notifications step writes this file for you; this is the by-hand route.
# After editing, recreate with: docker compose --profile monitor up -d mileage-monitor
# "docker compose restart" keeps the old values.
# This file is separate so neither ingest credentials nor viewer secrets reach
# the monitor. The checked-in example is safe to load when the profile is off.
# The installer and monitor share settings_rules.py. The installer quotes values
# safely; by hand, single-quote literal $, #, spaces and quotes, e.g.
# NTFY_TOKEN='fake$literal#value<suffix>'. An apostrophe inside single quotes is \'.
# For values with backslashes use double quotes: \\ for backslash, \" for quote,
# $$ for dollar. Keep one setting per line; do not use $OTHER/${OTHER} references.
# Unquoted or double-quoted references are expanded by Compose (including 2.26);
# the installer refuses to guess their values. Unquoted ' #' starts a comment.
# Disabled ticks still refresh /state/heartbeat without reading databases.
# Docker health checks local tick progress, not successful output delivery.
# Unreadable diagnostics or failed ticks stop refreshing the heartbeat.
MONITOR_ENABLED=false
NOTIFY_ENABLED=false
# Full topic URL. For the bundled ntfy service use http://ntfy:80/<topic>.
# HTTP is for a trusted LAN/container network; use HTTPS for remote servers.
NTFY_URL=https://<host>/<topic>
# Nonempty printable ASCII, no spaces/control characters; replace <token>.
# Real punctuation, including < and >, is allowed with the quoting above.
NTFY_TOKEN=<token>
# Minimum fault severity: info, warning, error or critical. Invalid tuning values
# stop an enabled monitor even when NOTIFY_ENABLED=false.
NOTIFY_MIN_SEVERITY=error
# Wait before sending a fault, in seconds (0-604800); critical faults skip this.
NOTIFY_HOLD_SECONDS=300
# Reminder interval in hours (1/3600-8760, i.e. at least 1 second).
NOTIFY_REPEAT_HOURS=24
# Maximum successful ntfy posts per rolling hour (integer, 1-1000).
NOTIFY_MAX_PER_HOUR=6
# E7001: no server contact for this many days (1/86400-36500, minimum 1 second).
MONITOR_STALE_DAYS=7
# Silence (warning E7001) is independent of NOTIFY_MIN_SEVERITY and bypasses
# the fault hold; all deliveries share the hourly cap, retries and reminders.
# Snapshot freshness is fixed at 24 hours of server receipt time.

# Optional authenticated Prometheus scrape endpoint (DEPLOY_DEBIAN.md Step 11e).
# Keep port 8093 LAN-only: this bearer token is its only protection.
# Requires MONITOR_ENABLED=true too. Generate a separate token with:
#   openssl rand -hex 32
# At least 32 printable ASCII characters (33-126; no spaces), any punctuation.
# Use the quoting above for a hand-written token. Invalid metrics
# settings stop the whole monitor.
METRICS_ENABLED=false
METRICS_TOKEN=<token>

# Optional event and condition-change push to an external Loki, plus
# decisions accepted by ntfy. A nonempty URL enables it and requires
# MONITOR_ENABLED=true too; Loki is never installed here. Use the full
# http(s) endpoint ending in /loki/api/v1/push, without credentials, query
# string or fragment. Set basic auth OR bearer auth, not both. Setup is
# in DEPLOY_DEBIAN.md Step 11f. Wrong token/tenant/URL/proxy errors retain
# history and warn on each retry, bounded by backoff. Only HTTP 400/422 skip
# rejected content; 413 and other HTTP errors retain it.
# Basic user/password: 1-1024 printable ASCII characters, spaces allowed; no
# colon in the username. Bearer: 1-1024 printable ASCII, no spaces, not <token>.
# Tenant: empty or up to 128 printable ASCII characters, spaces allowed.
LOKI_PUSH_URL=
#LOKI_PUSH_URL=https://<host>/loki/api/v1/push
LOKI_BASIC_AUTH_USER=
LOKI_BASIC_AUTH_PASSWORD=
LOKI_BEARER_TOKEN=
LOKI_TENANT_ID=

# Optional GELF export to a Graylog you run elsewhere (DEPLOY_DEBIAN.md Step 11d).
# Needs MONITOR_ENABLED=true; independent of NOTIFY_ENABLED and ntfy. Set exactly
# one of GRAYLOG_GELF_URL (a GELF HTTP input; preferred, Graylog confirms each
# message) or GRAYLOG_GELF_TCP (<host>:<port> of a GELF TCP input).
GRAYLOG_ENABLED=false
GRAYLOG_GELF_URL=http://<host>:12201/gelf
#GRAYLOG_GELF_TCP=<host>:12201
# TCP only: wrap in TLS. For HTTPS, use an https:// URL instead.
#GRAYLOG_GELF_TLS=false
# Verify the Graylog certificate (default true); optional private CA bundle.
#GRAYLOG_GELF_TLS_VERIFY=true
#GRAYLOG_GELF_CA_FILE=/state/graylog-ca.pem
# HTTP only: one extra header, e.g. for a proxy in front of the input.
#GRAYLOG_GELF_HEADER=<Header-Name>: <value>
