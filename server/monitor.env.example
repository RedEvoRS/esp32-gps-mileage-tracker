# Optional: copy to monitor.env, chmod 600, and set MONITOR_ENV_FILE=./monitor.env
# in .env. Then explicitly start the monitor profile (DEPLOY_DEBIAN.md Step 11).
# This file is separate so neither ingest credentials nor viewer secrets reach
# the monitor. The checked-in example is safe to load when the profile is off.
MONITOR_ENABLED=false
NOTIFY_ENABLED=false
# Full topic URL. For the bundled ntfy service use http://ntfy:80/<topic>.
# HTTP is for a trusted LAN/container network; use HTTPS for remote servers.
NTFY_URL=https://<host>/<topic>
NTFY_TOKEN=<token>
NOTIFY_MIN_SEVERITY=error
NOTIFY_HOLD_SECONDS=300
NOTIFY_REPEAT_HOURS=24
NOTIFY_MAX_PER_HOUR=6
MONITOR_STALE_DAYS=7
# Silence (warning E7001) is independent of NOTIFY_MIN_SEVERITY and bypasses
# the fault hold; all deliveries share the hourly cap, retries and reminders.
# Snapshot freshness is fixed at 24 hours of server receipt time.
