# Optional: copy to monitor.env, chmod 600, and set MONITOR_ENV_FILE=./monitor.env
# in .env. Then explicitly start the monitor profile (DEPLOY_DEBIAN.md Step 11).
# This file is separate so neither ingest credentials nor viewer secrets reach
# the monitor. The checked-in example is safe to load when the profile is off.
MONITOR_ENABLED=false
NOTIFY_ENABLED=false
# Full topic URL. For the bundled ntfy service use http://ntfy:80/<topic>.
# HTTP is for a trusted LAN/container network; use HTTPS for remote servers.
NTFY_URL=https://<host>/<topic>
NTFY_TOKEN=<token>
NOTIFY_MIN_SEVERITY=error
NOTIFY_HOLD_SECONDS=300
NOTIFY_REPEAT_HOURS=24
NOTIFY_MAX_PER_HOUR=6
MONITOR_STALE_DAYS=7
# Silence (warning E7001) is independent of NOTIFY_MIN_SEVERITY and bypasses
# the fault hold; all deliveries share the hourly cap, retries and reminders.
# Snapshot freshness is fixed at 24 hours of server receipt time.

# Optional authenticated Prometheus scrape endpoint (DEPLOY_DEBIAN.md Step 11e).
# Keep port 8093 LAN-only: this bearer token is its only protection.
METRICS_ENABLED=false
METRICS_TOKEN=<token>

# Optional event and condition-change push to an external Loki, plus
# decisions accepted by ntfy. A nonempty URL enables it; Loki is never
# installed here. Set basic auth OR bearer auth, not both. Setup is in
# DEPLOY_DEBIAN.md Step 11f.
LOKI_PUSH_URL=
#LOKI_PUSH_URL=https://<host>/loki/api/v1/push
LOKI_BASIC_AUTH_USER=
LOKI_BASIC_AUTH_PASSWORD=
LOKI_BEARER_TOKEN=
LOKI_TENANT_ID=

# Optional GELF export to a Graylog you run elsewhere (DEPLOY_DEBIAN.md Step 11d).
# Needs MONITOR_ENABLED=true; independent of NOTIFY_ENABLED and ntfy. Set exactly
# one of GRAYLOG_GELF_URL (a GELF HTTP input; preferred, Graylog confirms each
# message) or GRAYLOG_GELF_TCP (<host>:<port> of a GELF TCP input).
GRAYLOG_ENABLED=false
GRAYLOG_GELF_URL=http://<host>:12201/gelf
#GRAYLOG_GELF_TCP=<host>:12201
# TCP only: wrap in TLS. For HTTPS, use an https:// URL instead.
#GRAYLOG_GELF_TLS=false
# Verify the Graylog certificate (default true); optional private CA bundle.
#GRAYLOG_GELF_TLS_VERIFY=true
#GRAYLOG_GELF_CA_FILE=/state/graylog-ca.pem
# HTTP only: one extra header, e.g. for a proxy in front of the input.
#GRAYLOG_GELF_HEADER=<Header-Name>: <value>
