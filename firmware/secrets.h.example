// =================================================================
// secrets.h - WiFi and Server Configuration
// =================================================================
// IMPORTANT: This file contains your WiFi password and auth token.
// Do NOT share this file, commit it to git, or post it online.
//
// Instructions:
//   1. Copy this file to 04_trip_logger/secrets.h, next to
//      04_trip_logger.ino. The build doesn't look anywhere else.
//   2. Fill in your actual WiFi SSID and password
//   3. Fill in your server IP and the auth token. server/install.sh
//      prints both at the end; the token is also INGEST_AUTH_TOKEN in
//      the server's .env file.
//   4. The auth token here MUST match INGEST_AUTH_TOKEN in your
//      server's .env file exactly, or uploads will be rejected
//
// These values are compiled into the firmware. If any of them change
// later (the server's IP, the token, your WiFi name or password), the
// board can't upload until you update this file and flash it again.
// Trips just stop appearing in the viewer and wait on the board. The
// Serial Monitor explains each failure. On the production screen, a
// refused upload shows an error code, e.g. E5004 means the server rejected
// the upload token. WiFi join/connection warnings can appear on the automatic
// parked status card or a short POWER press; a WiFi name the board can't
// find never shows. See the error catalog in DIAGNOSTICS.md.
//
// To generate the auth token on your server by hand:
//   openssl rand -hex 32
// =================================================================

#ifndef SECRETS_H
#define SECRETS_H

// Your home WiFi network name (SSID), exactly as it appears, capitals
// included. This is how the T-Beam knows it's parked at home and should
// upload. It has to be a 2.4 GHz network (the ESP32 has no 5 GHz radio),
// and hidden networks won't work: the board only uploads when it sees
// this name in a WiFi scan.
#define WIFI_SSID     "YourWiFiNetworkName"

// Your home WiFi password. This is a C string, so write a " as \" and
// a \ as \\.
#define WIFI_PASSWORD "YourWiFiPassword"

// The IP address of your Debian server running the ingest service.
// Use only the IP address or hostname: no http://, port or /upload.
// Use a static IP or DHCP reservation so this doesn't change: if it
// does, uploads stop until you reflash with the new address.
#define SERVER_HOST   "192.168.1.XXX"

// The port your ingest service listens on (matches docker-compose.yml).
// NOTE: the ingest service speaks plain HTTP on the LAN (not HTTPS), so
// the firmware uploads over http://. Keep this on your home network only.
#define SERVER_PORT   8090

// Optional network time servers: used only while already on home WiFi and
// only if GPS has not set the clock. Leave these commented to use pool.ntp.org
// and time.nist.gov. To keep time requests on your LAN, set BOTH to your router
// or local time server (the same address is fine). Use just a hostname or IPv4
// address, without http://, a port or a path. These must be C string literals.
// If neither answers, the clock waits for GPS; trip uploads still work.
// An explicit empty string ("") leaves that slot unused. If both are empty,
// there is no network-time attempt and the clock waits for GPS.
// #define NTP_SERVER_1 "clock.example"
// #define NTP_SERVER_2 "clock.example"

// The auth token (must match INGEST_AUTH_TOKEN in server's .env file)
// This is not your viewer password or the server's SSH password.
// Generate with: openssl rand -hex 32
#define AUTH_TOKEN    "replace-me-with-your-actual-token"

// A unique identifier per tracker, sent with each upload (the trip's device_id).
// Use 1-32 characters: lowercase letters, digits, '_' or '-', starting with a
// letter or digit. Invalid IDs can upload trips but diagnostics are rejected,
// so the tracker won't appear in Device health.
#define DEVICE_ID     "tbeam-01"

// Diagnostics revisions are mirrored to SD and LittleFS. Enroll at least one
// mounted journal; internal flash can then report a missing card (E4001).
// A mounted card's read/write failures do not block healthy flash diagnostics
// (including trip-write faults, E4006); failed flash does not block healthy SD.
// NVS marks skipped copies stale before sending; they resync with a current copy.
// A v1.00 upgrade needs its enrolled card once to seed flash, or re-enrollment.
// Erase-all clears NVS and LittleFS, but an intact enrolled card can restore
// a genuinely missing witness when ready journal epochs agree. Suspended-only
// or disagreeing copies and NVS errors still block. Erasing loses stale-card
// protection: low revisions keep health old; a collision needs explicit recovery.
// Enable ONLY for a new DEVICE_ID whose
// server high-water revision is verified absent (0), or after reading its
// current devices.status_sequence from the ingest diagnostics database.
// Copy that revision below, and choose an enrollment ID greater than every
// value previously used on this board. NVS consumes the ID before restoring
// usable mounted journals; a failed attempt needs a new ID. The value must also
// meet both local revisions (serial prints the minimum on refusal). Never reuse 0
// after replacing/corrupting the card. See DIAGNOSTICS.md, revision recovery.
// DEPLOY_DEBIAN.md Step 8 has the command that reads the server's value.
// After Device health shows the first diagnostics snapshot, remove both defines
// and reflash with erase Disabled, so NVS and journal metadata are kept.
// Existing enrolled journal metadata needs neither define during normal operation.
// Without enrollment, GPX works and diagnostics remain queued locally.
// #define DIAGNOSTICS_ENROLLMENT_ID 1ULL
// #define DIAGNOSTICS_STATUS_HIGH_WATER 0ULL

// Optional: lock uploads to your exact router by its MAC address (BSSID)
// so the device never associates with a different network that happens
// to share your SSID (e.g. a coffee shop). Leave USE_BSSID_FILTER as 0
// to match by SSID only. To enable, set it to 1 and fill in WIFI_BSSID
// with your router's MAC (find it in your router admin page or via
// `WiFi.BSSIDstr()` printed after a test connection).
#define USE_BSSID_FILTER 0
static const uint8_t WIFI_BSSID[6] = { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };

#endif // SECRETS_H
